# Build outputs
# --------------
# Each kernel is built into a directory named after itself, holding the compiled
# binary (plus the -baseline variant) and that run's logs. Nothing in these
# directories is source.
/gapbs/bc/
/gapbs/bfs/
/gapbs/cc/
/gapbs/cc_sv/
/gapbs/pr/
/gapbs/pr_spmv/
/gapbs/sssp/
/gapbs/tc/
/gapbs-pin/bc/
/gapbs-pin/bfs/
/gapbs-pin/cc/
/gapbs-pin/cc_sv/
/gapbs-pin/pr/
/gapbs-pin/pr_spmv/
/gapbs-pin/sssp/
/gapbs-pin/tc/
/gapbs/converter
/gapbs-pin/converter

# Intermediate LLVM IR from the build pipeline (.ll, _optimized.ll, _linked.ll,
# _baseline_optimized.ll)
*.ll

# Generated data
# --------------
# Twitter graphs built by setup.sh: tens of GB per tree, regenerate rather than store.
# No trailing slash: setup.sh makes gapbs-pin's a symlink to gapbs's copy, and a
# trailing-slash pattern would match only a real directory.
/gapbs/benchmark/graphs
/gapbs-pin/benchmark/graphs

# Per-step logs from the run-ae.sh harness. Its ae_timing.txt and
# ae_timing_raw.txt summaries are already covered by the *.txt rule below.
/ae_logs/

# Tool logs, per-run timing files, and CSV/text result summaries. Everything matching
# these in this repo is generated by setup.sh or one of the run-*.sh scripts.
*.txt
*.csv
*.zlog

# Keep documentation and licensing even though they match the patterns above. The
# GAPBS and Pintool LICENSE files are extensionless and so are unaffected, but a
# future LICENSE.txt or NOTICE.txt would otherwise be silently ignored.
!LICENSE*
!COPYING*
!NOTICE*
!README*

# Staging tree written by the ROI patch generator. Holds fully annotated SPEC
# sources and must never be committed; the patches in spec/roi/ are the artifact.
/spec/.staged/

# SPEC CPU2017 tree installed by setup.sh --with-spec. Licensed and not
# redistributable; the ISO is always supplied by the user via --spec-path.
/spec2017/

# Reference harness for the SPEC2017 workflow, cloned here for convenience while
# that workflow is built out. It carries annotated SPEC sources and must never be
# committed to this repository.
/ZRay-SPEC-test-setup/

# A separate ZRay lineage, cloned here while the MST placement arm was ported across.
# It is its own repository and is not part of this artifact.
/customPass/

# Scratch tree for the counter-placement comparison (ZRay vs LLVM PGO's MST). Built
# from gapbs sources with its graphs symlinked to gapbs/. Not part of the artifact as
# submitted; ignored so an `add -A` cannot sweep it in. Force-add it deliberately if
# that study is ever included.
/gapbs-mst/

# Python bytecode from compare-zray-pin.py and the spec/ helpers.
__pycache__/

# Intel Pin and Pintool build artifacts
# -------------------------------------
# Pin is downloaded by setup.sh --with-pin and is subject to Intel's license; it is
# deliberately not vendored into this repository.
/pintool/pin-external-*/
/pintool/pin-external-*.tar.gz
/pintool/obj-intel64/
/pintool/*.a
/pintool/*.o
