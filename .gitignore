# Build outputs
# --------------
# Each kernel is built into a directory named after itself, holding the compiled
# binary (plus the -baseline variant) and that run's logs. Nothing in these
# directories is source.
/gapbs/bc/
/gapbs/bfs/
/gapbs/cc/
/gapbs/cc_sv/
/gapbs/pr/
/gapbs/pr_spmv/
/gapbs/sssp/
/gapbs/tc/
/gapbs-pin/bc/
/gapbs-pin/bfs/
/gapbs-pin/cc/
/gapbs-pin/cc_sv/
/gapbs-pin/pr/
/gapbs-pin/pr_spmv/
/gapbs-pin/sssp/
/gapbs-pin/tc/
/gapbs/converter
/gapbs-pin/converter

# Intermediate LLVM IR from the build pipeline (.ll, _optimized.ll, _linked.ll,
# _baseline_optimized.ll)
*.ll

# Generated data
# --------------
# Twitter graphs built by setup.sh: tens of GB per tree, regenerate rather than store.
/gapbs/benchmark/graphs/
/gapbs-pin/benchmark/graphs/

# Tool logs, per-run timing files, and CSV/text result summaries. Everything matching
# these in this repo is generated by setup.sh, run-gapbs.sh or run-pin.sh.
*.txt
*.csv
*.zlog

# Keep documentation and licensing even though they match the patterns above. The
# GAPBS and Pintool LICENSE files are extensionless and so are unaffected, but a
# future LICENSE.txt or NOTICE.txt would otherwise be silently ignored.
!LICENSE*
!COPYING*
!NOTICE*
!README*

# Intel Pin and Pintool build artifacts
# -------------------------------------
# Pin is downloaded by setup.sh --with-pin and is subject to Intel's license; it is
# deliberately not vendored into this repository.
/pintool/pin-external-*/
/pintool/pin-external-*.tar.gz
/pintool/obj-intel64/
/pintool/*.a
/pintool/*.o
